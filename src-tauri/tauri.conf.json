{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Storm-Breaker",
  "version": "1.0.0",
  "identifier": "com.stormbreaker.panel",
  "build": {
    "frontendDist": "../storm-web/flask_templates"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Storm-Breaker",
        "url": "http://127.0.0.1:2525/panel",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "Storm-Breaker"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png"],
    "resources": {
      "../sidecar/storm-breaker-backend/": "sidecar/storm-breaker-backend/"
    }
  }
}
